@page
@model Case_1_Event_eksamen.Pages.IndexModel

<div class="hero-section">
    <div>
        <h1>Zealand Zoo</h1>
        <p>
            Velkommen til Zealand Zoo Cafe. Vi har gaming nights, fodbold turneringer, quiz nights og meget mere. Tjek vores kommende events nedenfor og tilmeld dig for at deltage i sjove og spændende aktiviteter!
        </p>

    </div>
</div>

<section class="mt-4">
    <h2>Næste Events</h2>

    @if (Model.Events.Any())
    {
        <div class="card-grid">
            @foreach (var eventItem in Model.Events)
            {
                <div class="info-card">
                    <h2>@eventItem.Title</h2>
                    <p>@eventItem.Description</p>
                    <p>
                        <strong>Start Tid:</strong>
                        @eventItem.StartTime.ToString("dd/MM/yyyy HH:mm")
                    </p>
                    <p>
                        <strong>Slut Tid:</strong>
                        @eventItem.EndTime.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    @if (eventItem.MaxParticipants != null)
                    {
                        <p><strong>Max deltagere:</strong> @eventItem.MaxParticipants</p>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <p>Ingen kommende events endnu.</p>
    }
</section>

<section class="card-grid">

    <div class="info-card">
        <h2>Studenter sign up!</h2>
        <p>Skriv dig op for at deltage i kommende events og aktiviteter.</p>
    </div>

    <div class="info-card ">
        <h2>Åben hver fredag!</h2>
        <p>Kom og oplev vores spændende aktiviteter hver fredag.</p>
    </div>


    
</section>
    
@if (HttpContext.Session.GetString("UserRole") == "Admin")
{
    <button onclick="document.getElementById('newsletterModal').style.display='flex'"
            style="padding: 10px 20px; margin-top: 20px; cursor: pointer;">
     Skriv dig op til vores Nyhedsbrev
    </button>



<div id="newsletterModal"
     style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
    background:rgba(0,0,0,0.5); justify-content:center; align-items:center; z-index:1000;">
    
    <div style="background:white; padding:40px; border-radius:10px; width:400px; text-align:center;">
        <h3>Skriv dig op til vores Nyhedsbrev</h3>
        <p>Få besked om nye events i den kommende måned</p>

        <form method="post" asp-page-handler="Subscribe">
            <input type="email"
                   name="email"
                   placeholder="Email"
                   required
                   style="padding:10px; width:80%; margin:10px auto; display:block;" />

            <button type="submit" style="padding:10px 25px; margin-right:10px;">Subscribe</button>
            <button type="button" onclick="document.getElementById('newsletterModal').style.display='none'"
                    style="padding:10px 25px;">Cancel</button>
        </form>

        @if (Model.SubscribeSuccess)
        {
            <p style="color:green; margin-top:15px;">Tak for at skrive dig op!</p>
        }
    </div>
</div>

<form method="post" asp-page-handler="TestEmail">
    <button type="submit">Send test-mail</button>
</form>
}